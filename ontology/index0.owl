  <field_interior_regime_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"interior": {"differentiated": true, "core_radius_fraction": 0.5479, "mantle_radius_fraction": 0.44954329326228937, "crust_radius_fraction": 0.0025567067377105946, "mantle_present": true, "crust_thickness_km": 21.3383, "internal_heat_w_m2": 0.07036424606524787, "radiogenic_heat_multiplier": 0.72, "tectonic_regime": "episodic_lid", "volcanic_activity": "moderate", "crust_type": "mafic"}, "thermal_evolution": {"model_version": "thermal_evolution_v001", "radiogenic_elements": {"K_percent": 0.0, "U_percent": 0.0, "Th_percent": 0.0}, "radiogenic_heat_multiplier": 0.72, "internal_heat_w_m2": 0.07036, "mantle_fraction": 0.4495, "water_weakening_factor": 1.021, "derived_tectonic_regime": "episodic_lid", "note": "Initial thermal model derives heat from size, core/mantle geometry, and K/U/Th abundance; explicit seed modes may still override until the workflow is fully derived."}, "surface_processes": {"surface_pressure_bar": 0.07875134836972655, "surface_temperature_k": 253.42084595666807, "surface_temperature_c": -19.729154043331903, "surface_gravity_g": 1.3220060684002464, "liquid_water_possible": true, "hydrologic_cycle": "limited", "aeolian_activity": "weak", "erosion_processes": ["episodic_fluvial", "aeolian", "glacial"], "crater_retention": "moderate", "primary_topography": "rifted_stagnant_lid_with_resurfaced_provinces"}, "map_recipe": ["initialize_spherical_height_field", "apply_rifted_stagnant_lid_with_resurfaced_provinces", "apply_moderate_crater_population", "solve_limited_hydrology", "erode_episodic_fluvial", "erode_aeolian", "erode_glacial"], "notes": ["This regime selects which terrain processes are physically allowed before map synthesis.", "Plate boundaries are only enabled when mantle heat and surface conditions can support mobile lithosphere.", "Crater preservation rises when atmosphere, hydrology, tectonics, and volcanism cannot erase impacts."]}</field_interior_regime_mo