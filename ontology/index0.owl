  <field_interior_regime_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"interior": {"differentiated": true, "core_radius_fraction": 0.413, "mantle_radius_fraction": 0.5569935743996233, "crust_radius_fraction": 0.03000642560037671, "mantle_present": true, "crust_thickness_km": 122.3494, "internal_heat_w_m2": 0.054415379159996675, "radiogenic_heat_multiplier": 0.9049933333333333, "tectonic_regime": "stagnant_lid", "volcanic_activity": "low", "crust_type": "intermediate silicate"}, "thermal_evolution": {"model_version": "thermal_evolution_v001", "radiogenic_elements": {"K_percent": 2.7749, "U_percent": 0.0, "Th_percent": 0.0}, "radiogenic_heat_multiplier": 0.905, "internal_heat_w_m2": 0.05442, "mantle_fraction": 0.557, "water_weakening_factor": 1.047, "derived_tectonic_regime": "stagnant_lid", "note": "Initial thermal model derives heat from size, core/mantle geometry, and K/U/Th abundance; explicit seed modes may still override until the workflow is fully derived."}, "surface_processes": {"surface_pressure_bar": 1.0105236627050376, "surface_temperature_k": 439.73372891599377, "surface_temperature_c": 166.5837289159938, "surface_gravity_g": 0.5582243557961364, "liquid_water_possible": false, "hydrologic_cycle": "none", "aeolian_activity": "moderate", "erosion_processes": ["aeolian"], "crater_retention": "moderate", "primary_topography": "stagnant_lid_shields_and_old_basins"}, "map_recipe": ["initialize_spherical_height_field", "apply_stagnant_lid_shields_and_old_basins", "apply_moderate_crater_population", "erode_aeolian"], "notes": ["This regime selects which terrain processes are physically allowed before map synthesis.", "Plate boundaries are only enabled when mantle heat and surface conditions can support mobile lithosphere.", "Crater preservation rises when atmosphere, hydrology, tectonics, and volcanism cannot erase impacts."]}</field_interior_regime_model>
