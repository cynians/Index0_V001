  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">earth_reference_worldgen</field_tags>
  <field_wiki_entry rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Earth is a temperate terrestrial planet with liquid surface water, a nitrogen-oxygen atmosphere, active plate tectonics, and the only confirmed biosphere in the Solar System.</field_wiki_entry>
