  <field_interior_regime_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"interior": {"differentiated": true, "core_radius_fraction": 0.5836, "mantle_radius_fraction": 0.4119457776240526, "crust_radius_fraction": 0.004454222375947434, "mantle_present": true, "crust_thickness_km": 31.1078, "internal_heat_w_m2": 0.08146758140441755, "tectonic_regime": "stagnant_lid", "volcanic_activity": "moderate", "crust_type": "intermediate silicate"}, "surface_processes": {"surface_pressure_bar": 0.050022332223924416, "surface_temperature_k": 159.9316659742041, "surface_gravity_g": 1.1485046727471109, "liquid_water_possible": false, "hydrologic_cycle": "none", "aeolian_activity": "weak", "erosion_processes": ["aeolian", "glacial"], "crater_retention": "moderate", "primary_topography": "stagnant_lid_shields_and_old_basins"}, "map_recipe": ["initialize_spherical_height_field", "apply_stagnant_lid_shields_and_old_basins", "apply_moderate_crater_population", "erode_aeolian", "erode_glacial"], "notes": ["This regime selects which terrain processes are physically allowed before map synthesis.", "Plate boundaries are only enabled when mantle heat and surface conditions can support mobile lithosphere.", "Crater preservation rises when atmosphere, hydrology, tectonics, and volcanism cannot erase impacts."]}</field_interior_regime_model>
