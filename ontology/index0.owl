  <field_influence_domains rdf:datatype="http://www.w3.org/2001/XMLSchema#string">photography</field_influence_domains>
  <field_influence_domains rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portraiture</field_influence_domains>
