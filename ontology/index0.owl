  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pictorialism</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">japanese</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interwar</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">visual_art</field_tags>
  <field_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cultural_aspect</field_type>
  <field_wiki_entry rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Photographic art style derived from the work of Asahachi Kōno, emphasizing pictorialist softness, atmospheric composition, tonal delicacy, and a refined, emotionally shaped image surface over strict documentary sharpness.</field_wiki_entry>
</owl:NamedIndividual>

