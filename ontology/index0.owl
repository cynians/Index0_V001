  <entityType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">event</entityType>
  <field_card_color rdf:datatype="http://www.w3.org/2001/XMLSchema#string">#26201c</field_card_color>
  <field_end_year rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5941</field_end_year>
  <field_entry_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stub</field_entry_status>
  <field_name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CoG Quarantine Breach and Crackdown</field_name>
  <field_pretty_name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CoG Quarantine Breach and Crackdown</field_pretty_name>
  <field_start_year rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5742</field_start_year>
  <listFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tags</listFieldName>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cog</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">decline</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quarantine</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gang</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">purge</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disappearance</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">breach</field_tags>
  <field_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">event</field_type>
  <field_wiki_entry rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In 5742, a late-CoG underclass gang exploited a cracked ventilation shaft to escape the quarantined megastructure. The route was first used for gang escape, then for selected family extractions, later for paid passage, before discovery triggered a major GGO police purge, disappearances into a sealed sector, and later covert regime reuse of the breach route.

Historical importance was later largely erased from official memory and survived mostly through rumor, fragmentary reports, and local recollection.</field_wiki_entry>
  <listFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">associated_locations</listFieldName>
</owl:NamedIndividual>

