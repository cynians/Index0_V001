  <field_terrain_seed_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"cratering": {"density": 0.06, "enabled": true, "max_crater_diameter_km": 159.3, "retention": "low"}, "erosion": {"atmospheric_pressure_bar": 0.8713, "processes": ["fluvial", "coastal", "chemical_weathering", "aeolian", "glacial"], "strength": 0.71}, "heightfield": {"max_elevation_m": 8438.0, "min_elevation_m": -7977.6, "primary_topography": "plate_boundaries_mountain_belts_and_trenches", "relief_driver": "plate_boundary_relief", "resolution": "global_seed", "roughness": 0.62, "sea_level_m": 0.0, "target_ocean_fraction": 0.5}, "hydrology": {"cycle": "active", "drainage_enabled": true, "liquid_water_possible": true, "target_ocean_fraction": 0.5}, "map_canvas": {"height_px": 1024, "projection": "equirectangular", "vertical_datum": "mean_radius", "width_px": 2048}, "map_layers": [{"id": "elevation", "kind": "heightfield", "source": "plate_boundary_relief"}, {"id": "slope", "kind": "derived_raster", "source": "elevation"}, {"id": "crust_type", "kind": "classification", "source": "crust_composition"}, {"id": "tectonic_boundaries", "kind": "vector", "source": "plate_solver_seed"}, {"id": "water_mask", "kind": "raster_mask", "source": "sea_level"}, {"id": "erosion_potential", "kind": "raster", "source": "surface_process_model"}, {"id": "climate_stub", "kind": "placeholder", "source": "atmosphere_model"}], "map_recipe": ["allocate_map_canvas", "initialize_spherical_height_field", "apply_plate_boundaries_mountain_belts_and_trenches", "solve_active_hydrology", "erode_fluvial", "erode_coastal", "erode_chemical_weathering", "erode_aeolian", "erode_glacial", "seed_heightfield_layers", "derive_water_and_erosion_masks"], "notes": ["This is a deterministic terrain scaffold, not a finished elevation raster.", "The next pass can replace layer seeds with plate polygons, crater fields, drainage, and erosion iterations."], "status": "terrain_seeded", "tectonics": {"boundary_style": "subduction_rift_trans