  <field_effective_year rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2090</field_effective_year>
  <field_entry_status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">draft</field_entry_status>
  <field_institution_class rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interplanetary_treaty_framework</field_institution_class>
  <field_institution_domain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">legal</field_institution_domain>
  <listFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">institution_mechanisms</listFieldName>
  <field_institution_mechanisms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">treaty obligation</field_institution_mechanisms>
  <field_institution_mechanisms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diplomatic recognition</field_institution_mechanisms>
  <field_institution_mechanisms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">negotiated sovereignty claims</field_institution_mechanisms>
  <field_institution_mechanisms rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inter-state enforcement</field_institution_mechanisms>
  <field_institution_scope rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interplanetary</field_institution_scope>
  <field_jurisdiction_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interplanetary treaty framework</field_jurisdiction_model>
  <field_legal_scope rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exploration, colonization, and sovereignty rules for celestial bodies and off-world settlements during the Race for Sol.</field_legal_scope>
  <field_name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Race for Sol Outer Space Treaty Adaptation</field_name>
  <field_pretty_name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Race for Sol Outer Space Treaty Adaptation</field_pretty_name>
  <field_sovereignty_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">States may exercise bounded sovereignty around established off-world colonies rather than claiming unlimited sovereignty over entire celestial bodies.</field_sovereignty_model>
  <field_start_year rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2090</field_start_year>
  <listFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tags</listFieldName>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">institution</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">treaty</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">race_for_sol</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outer_space</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">colonization</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sovereignty</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interplanetary_law</field_tags>
  <field_territorial_rule rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sovereignty extends over a limited radius around an established colony, analogous to territorial waters or a controlled coastal zone.</field_territorial_rule>
  <listFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">treaty_domains</listFieldName>
  <field_treaty_domains rdf:datatype="http://www.w3.org/2001/XMLSchema#string">colonization</field_treaty_domains>
  <field_treaty_domains rdf:datatype="http://www.w3.org/2001/XMLSchema#string">orbital_law</field_treaty_domains>
  <field_treaty_domains rdf:datatype="http://www.w3.org/2001/XMLSchema#string">celestial_sovereignty</field_treaty_domains>
  <field_treaty_domains rdf:datatype="http://www.w3.org/2001/XMLSchema#string">settlement_jurisdiction</field_treaty_domains>
  <field_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">institution</field_type>
  <field_wiki_entry rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Race for Sol adaptation of the Outer Space Treaty framework for an era of permanent off-world colonies. The treaty largely preserves the original baseline principles of non-total appropriation, but allows states to hold sovereignty within a bounded radius around established colonies.

Intended to regulate the transition from exploration to sustained colonization after 2090. The main adaptation is the recognition of limited territorial sovereignty around colonies, treated analogously to territorial waters rather than full ownership of whole planets or moons.</field_wiki_entry>
</owl:NamedIndividual>

