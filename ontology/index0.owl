  <field_interior_regime_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"interior": {"differentiated": true, "core_radius_fraction": 0.4601, "mantle_radius_fraction": 0.5351677848727908, "crust_radius_fraction": 0.004732215127209181, "mantle_present": true, "crust_thickness_km": 40.0589, "internal_heat_w_m2": 0.1060877826254749, "tectonic_regime": "mobile_lid", "volcanic_activity": "moderate", "crust_type": "felsic silicate"}, "surface_processes": {"surface_pressure_bar": 1.8070124108710808, "surface_temperature_k": 271.6771393718393, "surface_gravity_g": 1.2327248456078228, "liquid_water_possible": true, "hydrologic_cycle": "active", "aeolian_activity": "strong", "erosion_processes": ["fluvial", "coastal", "chemical_weathering", "aeolian", "glacial"], "crater_retention": "low", "primary_topography": "plate_boundaries_mountain_belts_and_trenches"}, "map_recipe": ["initialize_spherical_height_field", "apply_plate_boundaries_mountain_belts_and_trenches", "solve_active_hydrology", "erode_fluvial", "erode_coastal", "erode_chemical_weathering", "erode_aeolian", "erode_glacial"], "notes": ["This regime selects which terrain processes are physically allowed before map synthesis.", "Plate boundaries are only enabled when mantle heat and surface conditions can support mobile lithosphere.", "Crater preservation rises when atmosphere, hydrology, tectonics, and volcanism cannot erase impacts."]}</field_interior_regime_model>
