  <field_behavioural_modifiers rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"atmospheric_composition": "high", "formal_staging": "moderate", "romantic_visualization": "high", "tonal_softness": "strong"}</field_behavioural_modifiers>
  <listFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">historical_examples</listFieldName>
