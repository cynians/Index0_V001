  <field_habitats rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rocky_scrubland</field_habitats>
  <field_habitats rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lowland_generalist</field_habitats>
  <field_lifecycle_notes rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The original release form was a microraptor-like gliding omnivore somewhat larger than a turkey, equipped with enlarged grasping claws and a modified beak suited to broad opportunistic feeding. Later CEAG-guided divergence produced both more specialized predator branches and highly adaptable generalist branches.</field_lifecycle_notes>
  <listFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">locomotion_types</listFieldName>
  <field_locomotion_types rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gliding</field_locomotion_types>
