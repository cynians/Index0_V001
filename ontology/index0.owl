  <field_interior_regime_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"interior": {"core_radius_fraction": 0.55, "crust_radius_fraction": 0.00549364307016167, "crust_thickness_km": 35.0, "crust_type": "intermediate silicate", "differentiated": true, "internal_heat_w_m2": 0.07910192669910529, "mantle_present": true, "mantle_radius_fraction": 0.44450635692983825, "tectonic_regime": "plate_tectonics", "volcanic_activity": "moderate"}, "map_recipe": ["initialize_spherical_height_field", "apply_plate_boundaries_mountain_belts_and_trenches", "solve_limited_hydrology", "erode_episodic_fluvial", "erode_aeolian", "erode_glacial"], "notes": ["This regime selects which terrain processes are physically allowed before map synthesis.", "Plate boundaries are only enabled when mantle heat and surface conditions can support mobile lithosphere.", "Crater preservation rises when atmosphere, hydrology, tectonics, and volcanism cannot erase impacts."], "surface_processes": {"aeolian_activity": "moderate", "crater_retention": "low", "erosion_processes": ["episodic_fluvial", "aeolian", "glacial"], "hydrologic_cycle": "limited", "liquid_water_possible": true, "primary_topography": "plate_boundaries_mountain_belts_and_trenches", "surface_gravity_g": 1.0084517077363087, "surface_pressure_bar": 0.8265864493892546, "surface_temperature_k": 252.1460104265287}}</field_interior_regime_model>
