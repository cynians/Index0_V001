  <field_interior_regime_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"interior": {"differentiated": true, "core_radius_fraction": 0.6113, "mantle_radius_fraction": 0.37019217966515566, "crust_radius_fraction": 0.01850782033484436, "mantle_present": true, "crust_thickness_km": 78.7661, "internal_heat_w_m2": 0.03743411771940579, "radiogenic_heat_multiplier": 0.72, "tectonic_regime": "episodic_lid", "volcanic_activity": "low", "crust_type": "felsic silicate"}, "thermal_evolution": {"model_version": "thermal_evolution_v001", "radiogenic_elements": {"K_percent": 0.0, "U_percent": 0.0, "Th_percent": 0.0}, "radiogenic_heat_multiplier": 0.72, "internal_heat_w_m2": 0.03743, "mantle_fraction": 0.3702, "water_weakening_factor": 1.012, "derived_tectonic_regime": "episodic_lid", "note": "Initial thermal model derives heat from size, core/mantle geometry, and K/U/Th abundance; explicit seed modes may still override until the workflow is fully derived."}, "surface_processes": {"surface_pressure_bar": 2.088519730607975, "surface_temperature_k": 298.0022042524521, "surface_temperature_c": 24.85220425245211, "surface_gravity_g": 0.7144938142175437, "liquid_water_possible": true, "hydrologic_cycle": "active", "aeolian_activity": "strong", "erosion_processes": ["fluvial", "coastal", "chemical_weathering", "aeolian"], "crater_retention": "low", "primary_topography": "rifted_stagnant_lid_with_resurfaced_provinces"}, "map_recipe": ["initialize_spherical_height_field", "apply_rifted_stagnant_lid_with_resurfaced_provinces", "solve_active_hydrology", "erode_fluvial", "erode_coastal", "erode_chemical_weathering", "erode_aeolian"], "notes": ["This regime selects which terrain processes are physically allowed before map synthesis.", "Plate boundaries are only enabled when mantle heat and surface conditions can support mobile lithosphere.", "Crater preservation rises when atmosphere, hydrology, tectonics, and volcanism cannot erase impacts."]}</field_interior_regime_model>
