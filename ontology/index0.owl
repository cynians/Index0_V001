  <field_origin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Derived from medieval crusading traditions and later reproduced in Cultural Seeding Group experimental societies.
</field_origin>
  <field_wiki_entry rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Religious belief that warfare in defense of sacred territory is spiritually justified.</field_wiki_entry>
