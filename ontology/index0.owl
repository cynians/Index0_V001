  <field_behavioural_modifiers rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"feint_complexity": "high", "mobility_emphasis": "high", "precision_control": "high", "ritual_formality": "moderate"}</field_behavioural_modifiers>
</owl:NamedIndividual>

