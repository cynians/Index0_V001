  <field_interior_regime_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"interior": {"core_radius_fraction": 0.55, "crust_radius_fraction": 0.00549364307016167, "crust_thickness_km": 35.0, "crust_type": "intermediate silicate", "differentiated": true, "internal_heat_w_m2": 0.07910192669910529, "mantle_present": true, "mantle_radius_fraction": 0.44450635692983825, "tectonic_regime": "episodic_lid", "volcanic_activity": "moderate"}, "map_recipe": ["initialize_spherical_height_field", "apply_rifted_stagnant_lid_with_resurfaced_provinces", "apply_moderate_crater_population", "erode_aeolian", "erode_glacial"], "notes": ["This regime selects which terrain processes are physically allowed before map synthesis.", "Plate boundaries are only enabled when mantle heat and surface conditions can support mobile lithosphere.", "Crater preservation rises when atmosphere, hydrology, tectonics, and volcanism cannot erase impacts."], "surface_processes": {"aeolian_activity": "moderate", "crater_retention": "moderate", "erosion_processes": ["aeolian", "glacial"], "hydrologic_cycle": "none", "liquid_water_possible": false, "primary_topography": "rifted_stagnant_lid_with_resurfaced_provinces", "surface_gravity_g": 1.0084517066384866, "surface_pressure_bar": 0.7260299717830789, "surface_temperature_k": 201.73046769643602}}</field_interior_regime_model>
