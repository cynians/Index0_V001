  <field_interior_regime_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"interior": "{'differentiated': True, 'core_radius_fraction': 0.55, 'mantle_radius_fraction': 0.44450635692983825, 'crust_radius_fraction': 0.00549364307016167, 'mantle_present': True, 'crust_thickness_km': 35.0, 'internal_heat_w_m2': 0.07910192669910529, 'tectonic_regime': 'episodic_lid', 'volcanic_activity': 'moderate', 'crust_type': 'intermediate silicate'}", "map_recipe": ["initialize_spherical_height_field", "apply_rifted_stagnant_lid_with_resurfaced_provinces", "apply_moderate_crater_population", "erode_aeolian", "erode_glacial"], "notes": ["This regime selects which terrain processes are physically allowed before map synthesis.", "Plate boundaries are only enabled when mantle heat and surface conditions can support mobile lithosphere.", "Crater preservation rises when atmosphere, hydrology, tectonics, and volcanism cannot erase impacts."], "surface_processes": "{'surface_pressure_bar': 0.8267290949095422, 'surface_temperature_k': 248.7499844813902, 'surface_gravity_g': 1.0084517066384866, 'liquid_water_possible': False, 'hydrologic_cycle': 'none', 'aeolian_activity': 'moderate', 'erosion_processes': ['aeolian', 'glacial'], 'crater_retention': 'moderate', 'primary_topography': 'rifted_stagnant_lid_with_resurfaced_provinces'}"}</field_interior_regime_model>
