  <jsonFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interior_regime_model</jsonFieldName>
  <field_interior_regime_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"interior": {"differentiated": true, "core_radius_fraction": 0.5213, "mantle_radius_fraction": 0.4697529875038446, "crust_radius_fraction": 0.008947012496155562, "mantle_present": true, "crust_thickness_km": 44.2616, "internal_heat_w_m2": 0.06694373448370579, "tectonic_regime": "mobile_lid", "volcanic_activity": "moderate", "crust_type": "intermediate silicate"}, "surface_processes": {"surface_pressure_bar": 1.1040404993667665, "surface_temperature_k": 266.67308675681136, "surface_gravity_g": 0.7579054904477875, "liquid_water_possible": true, "hydrologic_cycle": "active", "aeolian_activity": "moderate", "erosion_processes": ["fluvial", "coastal", "chemical_weathering", "aeolian", "glacial"], "crater_retention": "low", "primary_topography": "plate_boundaries_mountain_belts_and_trenches"}, "map_recipe": ["initialize_spherical_height_field", "apply_plate_boundaries_mountain_belts_and_trenches", "solve_active_hydrology", "erode_fluvial", "erode_coastal", "erode_chemical_weathering", "erode_aeolian", "erode_glacial"], "notes": ["This regime selects which terrain processes are physically allowed before map synthesis.", "Plate boundaries are only enabled when mantle heat and surface conditions can support mobile lithosphere.", "Crater preservation rises when atmosphere, hydrology, tectonics, and volcanism cannot erase impacts."]}</field_interior_regime_model>
