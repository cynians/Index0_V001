<owl:NamedIndividual rdf:about="https://index0.local/entity/spec_rheithrosciurus_macrotis">
  <rdf:type rdf:resource="#species_entry"/>
  <hasParent rdf:resource="https://index0.local/entity/cladis_sciurini"/>
  <entryId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">spec_rheithrosciurus_macrotis</entryId>
  <datasetName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">species</datasetName>
  <entityType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">species</entityType>
  <field_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">species</field_type>
  <field_lifecycle_notes rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solitary forest mammal spending much of its active time on the ground in dense tropical forest, using powerful dentition to process very hard food items and retreating into cover when disturbed.</field_lifecycle_notes>
  <field_population_notes rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Best represented as a low-density tropical forest specialist dependent on intact rainforest structure and vulnerable to habitat fragmentation.</field_population_notes>
  <listFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">morphological_traits</listFieldName>
  <field_morphological_traits rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extremely_bushy_tail</field_morphological_traits>
  <field_morphological_traits rdf:datatype="http://www.w3.org/2001/XMLSchema#string">powerful_jaws</field_morphological_traits>
  <field_morphological_traits rdf:datatype="http://www.w3.org/2001/XMLSchema#string">robust_incisors</field_morphological_traits>
  <field_morphological_traits rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dense_dark_fur</field_morphological_traits>
  <field_metabolism_class rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endothermic</field_metabolism_class>
  <field_representative_body_mass_kg rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.8</field_representative_body_mass_kg>
  <field_clade_class rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mammal</field_clade_class>
  <field_representative_body_length_m rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.35</field_representative_body_length_m>
  <field_origin_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">natural</field_origin_type>
  <field_species_class rdf:datatype="http://www.w3.org/2001/XMLSchema#string">natural_vertebrate</field_species_class>
  <listFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">habitats</listFieldName>
  <field_habitats rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tropical_lowland_forest</field_habitats>
  <field_habitats rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dense_rainforest</field_habitats>
