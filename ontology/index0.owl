  <field_interior_regime_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"interior": {"differentiated": true, "core_radius_fraction": 0.1738, "mantle_radius_fraction": 0.8024389931372096, "crust_radius_fraction": 0.023761006862790476, "mantle_present": true, "crust_thickness_km": 116.0641, "internal_heat_w_m2": 0.03763694602804274, "radiogenic_heat_multiplier": 0.72, "tectonic_regime": "inactive", "volcanic_activity": "low", "crust_type": "metal-rich"}, "thermal_evolution": {"model_version": "thermal_evolution_v001", "radiogenic_elements": {"K_percent": 0.0, "U_percent": 0.0, "Th_percent": 0.0}, "radiogenic_heat_multiplier": 0.72, "internal_heat_w_m2": 0.03764, "mantle_fraction": 0.8024, "water_weakening_factor": 1.004, "derived_tectonic_regime": "inactive", "note": "Initial thermal model derives heat from size, core/mantle geometry, and K/U/Th abundance; explicit seed modes may still override until the workflow is fully derived."}, "surface_processes": {"surface_pressure_bar": 0.0004660340176855626, "surface_temperature_k": 177.47838300091257, "surface_temperature_c": -95.6716169990874, "surface_gravity_g": 0.6174262036978807, "liquid_water_possible": false, "hydrologic_cycle": "none", "aeolian_activity": "none", "erosion_processes": ["impact_gardening"], "crater_retention": "high", "primary_topography": "impact_basins_cratered_highlands"}, "map_recipe": ["initialize_spherical_height_field", "apply_impact_basins_cratered_highlands", "apply_high_crater_population"], "notes": ["This regime selects which terrain processes are physically allowed before map synthesis.", "Plate boundaries are only enabled when mantle heat and surface conditions can support mobile lithosphere.", "Crater preservation rises when atmosphere, hydrology, tectonics, and volcanism cannot erase impacts."]}</field_interior_regime_model>
