  <field_interior_regime_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"interior": {"core_radius_fraction": 0.55, "crust_radius_fraction": 0.002746821535080835, "crust_thickness_km": 35.0, "crust_type": "metal-rich", "differentiated": true, "internal_heat_w_m2": 0.13385512930881385, "mantle_present": true, "mantle_radius_fraction": 0.4472531784649191, "tectonic_regime": "plate_tectonics", "volcanic_activity": "moderate"}, "map_recipe": ["initialize_spherical_height_field", "apply_plate_boundaries_mountain_belts_and_trenches", "solve_active_hydrology", "erode_fluvial", "erode_coastal", "erode_chemical_weathering", "erode_aeolian", "erode_glacial"], "notes": ["This regime selects which terrain processes are physically allowed before map synthesis.", "Plate boundaries are only enabled when mantle heat and surface conditions can support mobile lithosphere.", "Crater preservation rises when atmosphere, hydrology, tectonics, and volcanism cannot erase impacts."], "surface_processes": {"aeolian_activity": "strong", "crater_retention": "low", "erosion_processes": ["fluvial", "coastal", "chemical_weathering", "aeolian", "glacial"], "hydrologic_cycle": "active", "liquid_water_possible": true, "primary_topography": "plate_boundaries_mountain_belts_and_trenches", "surface_gravity_g": 2.0228339247792384, "surface_pressure_bar": 1.7659340163322752, "surface_temperature_k": 272.87125518833835}}</field_interior_regime_model>
