  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">japanese</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interwar</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">visual_art</field_tags>
