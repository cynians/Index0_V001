  <field_interior_regime_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"interior": {"differentiated": true, "core_radius_fraction": 0.6644, "mantle_radius_fraction": 0.3323045684338395, "crust_radius_fraction": 0.003295431566160595, "mantle_present": true, "crust_thickness_km": 18.3498, "internal_heat_w_m2": 0.05420510692256461, "radiogenic_heat_multiplier": 0.8996933333333332, "tectonic_regime": "stagnant_lid", "volcanic_activity": "low", "crust_type": "intermediate silicate"}, "thermal_evolution": {"model_version": "thermal_evolution_v001", "radiogenic_elements": {"K_percent": 2.6954, "U_percent": 0.0, "Th_percent": 0.0}, "radiogenic_heat_multiplier": 0.9, "internal_heat_w_m2": 0.05421, "mantle_fraction": 0.3323, "water_weakening_factor": 1.229, "derived_tectonic_regime": "stagnant_lid", "note": "Initial thermal model derives heat from size, core/mantle geometry, and K/U/Th abundance; explicit seed modes may still override until the workflow is fully derived."}, "surface_processes": {"surface_pressure_bar": 1.4025132458656626, "surface_temperature_k": 261.4793593579343, "surface_temperature_c": -11.670640642065678, "surface_gravity_g": 1.0141771464534872, "liquid_water_possible": true, "hydrologic_cycle": "active", "aeolian_activity": "moderate", "erosion_processes": ["fluvial", "coastal", "chemical_weathering", "aeolian", "glacial"], "crater_retention": "low", "primary_topography": "stagnant_lid_shields_and_old_basins"}, "map_recipe": ["initialize_spherical_height_field", "apply_stagnant_lid_shields_and_old_basins", "solve_active_hydrology", "erode_fluvial", "erode_coastal", "erode_chemical_weathering", "erode_aeolian", "erode_glacial"], "notes": ["This regime selects which terrain processes are physically allowed before map synthesis.", "Plate boundaries are only enabled when mantle heat and surface conditions can support mobile lithosphere.", "Crater preservation rises when atmosphere, hydrology, tectonics, and volcanism cannot erase impacts."]}