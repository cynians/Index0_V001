  <listFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parents</listFieldName>
  <listFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uses_technology</listFieldName>
</owl:NamedIndividual>

