  <field_interior_regime_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"interior": {"differentiated": true, "core_radius_fraction": 0.6278, "mantle_radius_fraction": 0.36567054688108264, "crust_radius_fraction": 0.0065294531189173345, "mantle_present": true, "crust_thickness_km": 47.7267, "internal_heat_w_m2": 0.07837261459227823, "tectonic_regime": "episodic_lid", "volcanic_activity": "moderate", "crust_type": "felsic silicate"}, "surface_processes": {"surface_pressure_bar": 1.0402997299476708, "surface_temperature_k": 235.9941950024223, "surface_gravity_g": 1.2656204500902961, "liquid_water_possible": false, "hydrologic_cycle": "none", "aeolian_activity": "moderate", "erosion_processes": ["aeolian", "glacial"], "crater_retention": "moderate", "primary_topography": "rifted_stagnant_lid_with_resurfaced_provinces"}, "map_recipe": ["initialize_spherical_height_field", "apply_rifted_stagnant_lid_with_resurfaced_provinces", "apply_moderate_crater_population", "erode_aeolian", "erode_glacial"], "notes": ["This regime selects which terrain processes are physically allowed before map synthesis.", "Plate boundaries are only enabled when mantle heat and surface conditions can support mobile lithosphere.", "Crater preservation rises when atmosphere, hydrology, tectonics, and volcanism cannot erase impacts."]}</field_interior_regime_model>
