  <field_locomotion_types rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ground_running</field_locomotion_types>
  <field_metabolism_class rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endothermic</field_metabolism_class>
  <listFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">morphological_traits</listFieldName>
  <field_morphological_traits rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parrot_derived_beak</field_morphological_traits>
  <field_morphological_traits rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enlarged_grasping_claws</field_morphological_traits>
  <field_morphological_traits rdf:datatype="http://www.w3.org/2001/XMLSchema#string">microraptor_like_gliding_planform</field_morphological_traits>
  <field_morphological_traits rdf:datatype="http://www.w3.org/2001/XMLSchema#string">turkey_plus_body_size</field_morphological_traits>
  <field_origin_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bioengineered</field_origin_type>
  <field_parent_clade rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psittacoraptorinae</field_parent_clade>
  <field_population_notes rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Particularly successful on lower-diversity Earth-like seeded worlds, where it expanded into many available niches and became one of the dominant engineered vertebrate lineages.</field_population_notes>
  <field_representative_body_length_m rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.15</field_representative_body_length_m>
  <field_representative_body_mass_kg rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">9.5</field_representative_body_mass_kg>
  <field_reproduction_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">egg_laying</field_reproduction_type>
  <field_simulation_tier_default rdf:datatype="http://www.w3.org/2001/XMLSchema#string">species_population</field_simulation_tier_default>
  <field_species_class rdf:datatype="http://www.w3.org/2001/XMLSchema#string">engineered_vertebrate</field_species_class>
  <field_start_year rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4457</field_start_year>
  <listFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tags</listFieldName>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">species</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bioengineered</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bird</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">theropod_like</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gliding</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">planetary_period</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">terran_bdp</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ceag</field_tags>
  <field_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">species</field_type>
  <field_wiki_entry rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bioengineered parrot-derived theropod lineage created by the Terran BDP during the Planetary Period as an omnivorous generalist. On at least one seeded Earth-like world with reduced biodiversity, later exposure to CEAG drove rapid diversification into predator and generalist branches across nearly all major ecosystems.</field_wiki_entry>
