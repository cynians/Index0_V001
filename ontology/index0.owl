  <field_influence_domains rdf:datatype="http://www.w3.org/2001/XMLSchema#string">photography</field_influence_domains>
  <field_influence_domains rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portraiture</field_influence_domains>
  <field_influence_domains rdf:datatype="http://www.w3.org/2001/XMLSchema#string">visual_composition</field_influence_domains>
  <field_influence_domains rdf:datatype="http://www.w3.org/2001/XMLSchema#string">print_culture</field_influence_domains>
  <field_origin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rooted in the interwar photographic culture surrounding Asahachi Kōno and related pictorialist circles, including the Japanese Camera Pictorialists of California in Los Angeles.
</field_origin>
  <field_wiki_entry rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Photographic art style derived from the work of Asahachi Kōno, emphasizing pictorialist softness, atmospheric composition, tonal delicacy, and a refined, emotionally shaped image surface over strict documentary sharpness.</field_wiki_entry>
  <listFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">historical_examples</listFieldName>
  <field_historical_examples rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asahachi_kono</field_historical_examples>
  <field_historical_examples rdf:datatype="http://www.w3.org/2001/XMLSchema#string">japanese_camera_pictorialists_of_california</field_historical_examples>
  <field_aspect_class rdf:datatype="http://www.w3.org/2001/XMLSchema#string">art_style</field_aspect_class>
  <jsonFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">behavioural_modifiers</jsonFieldName>
  <field_behavioural_modifiers rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"atmospheric_composition": "high", "formal_staging": "moderate", "romantic_visualization": "high", "tonal_softness": "strong"}</field_behavioural_modifiers>
</owl:NamedIndividual>

