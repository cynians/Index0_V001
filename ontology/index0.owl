  <field_urban_structure rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"central_district": "cog_central_core_district", "later_expansion": true, "later_expansion_notes": "Additional outer habitation and production districts were added beyond the original five-ring structure.", "original_ring_count": 5, "outer_boundary": "cog_outer_wall", "primary_structural_zones": ["cog_ring_1", "cog_ring_2", "cog_ring_3", "cog_ring_4", "cog_ring_5", "cog_infrastructure_belts"], "structure_type": "concentric_ring_megastructure"}</field_urban_structure>
