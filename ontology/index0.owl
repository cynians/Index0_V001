  <field_name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asahachi Kōno Photographic Pictorialism</field_name>
  <field_origin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rooted in the interwar photographic culture surrounding Asahachi Kōno and related pictorialist circles, including the Japanese Camera Pictorialists of California in Los Angeles.
</field_origin>
  <field_pretty_name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asahachi Kōno Photographic Pictorialism</field_pretty_name>
