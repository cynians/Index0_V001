  <field_interior_regime_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"interior": {"differentiated": true, "core_radius_fraction": 0.6331, "mantle_radius_fraction": 0.3624009350329465, "crust_radius_fraction": 0.0044990649670535645, "mantle_present": true, "crust_thickness_km": 40.986, "internal_heat_w_m2": 0.08234820878294916, "radiogenic_heat_multiplier": 0.8939666666666666, "tectonic_regime": "episodic_lid", "volcanic_activity": "moderate", "crust_type": "intermediate silicate"}, "thermal_evolution": {"model_version": "thermal_evolution_v001", "radiogenic_elements": {"K_percent": 2.6095, "U_percent": 0.0, "Th_percent": 0.0}, "radiogenic_heat_multiplier": 0.894, "internal_heat_w_m2": 0.08235, "mantle_fraction": 0.3624, "water_weakening_factor": 1.35, "derived_tectonic_regime": "episodic_lid", "note": "Initial thermal model derives heat from size, core/mantle geometry, and K/U/Th abundance; explicit seed modes may still override until the workflow is fully derived."}, "surface_processes": {"surface_pressure_bar": 1.5908575560369183, "surface_temperature_k": 222.27951488476026, "surface_temperature_c": -50.87048511523972, "surface_gravity_g": 1.5908575560369183, "liquid_water_possible": false, "hydrologic_cycle": "none", "aeolian_activity": "strong", "erosion_processes": ["aeolian", "glacial"], "crater_retention": "moderate", "primary_topography": "rifted_stagnant_lid_with_resurfaced_provinces"}, "map_recipe": ["initialize_spherical_height_field", "apply_rifted_stagnant_lid_with_resurfaced_provinces", "apply_moderate_crater_population", "erode_aeolian", "erode_glacial"], "notes": ["This regime selects which terrain processes are physically allowed before map synthesis.", "Plate boundaries are only enabled when mantle heat and surface conditions can support mobile lithosphere.", "Crater preservation rises when atmosphere, hydrology, tectonics, and volcanism cannot erase impacts."]}</field_interior_regime_model>
