  <jsonFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interior_regime_model</jsonFieldName>
  <field_interior_regime_model rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{"interior": {"differentiated": true, "core_radius_fraction": 0.4855, "mantle_radius_fraction": 0.5093348485031672, "crust_radius_fraction": 0.005165151496832725, "mantle_present": true, "crust_thickness_km": 28.9649, "internal_heat_w_m2": 0.07646319570768588, "tectonic_regime": "episodic_lid", "volcanic_activity": "moderate", "crust_type": "mafic"}, "surface_processes": {"surface_pressure_bar": 0.8226784598597394, "surface_temperature_k": 238.46125440355846, "surface_gravity_g": 0.8340179574159671, "liquid_water_possible": false, "hydrologic_cycle": "none", "aeolian_activity": "moderate", "erosion_processes": ["aeolian", "glacial"], "crater_retention": "moderate", "primary_topography": "rifted_stagnant_lid_with_resurfaced_provinces"}, "map_recipe": ["initialize_spherical_height_field", "apply_rifted_stagnant_lid_with_resurfaced_provinces", "apply_moderate_crater_population", "erode_aeolian", "erode_glacial"], "notes": ["This regime selects which terrain processes are physically allowed before map synthesis.", "Plate boundaries are only enabled when mantle heat and surface conditions can support mobile lithosphere.", "Crater preservation rises when atmosphere, hydrology, tectonics, and volcanism cannot erase impacts."]}</field_interior_regime_model>
