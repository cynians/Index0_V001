  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mammal</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">squirrel</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rainforest</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">borneo</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">terrestrial</field_tags>
  <field_tags rdf:datatype="http://www.w3.org/2001/XMLSchema#string">natural</field_tags>
  <field_simulation_tier_default rdf:datatype="http://www.w3.org/2001/XMLSchema#string">species_population</field_simulation_tier_default>
  <field_wiki_entry rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Large terrestrial squirrel native to the lowland forests of Borneo, known for its extremely bushy tail and powerful jaws. Despite its common name, it is primarily a forest-floor rodent that forages among dense vegetation and fallen material for hard seeds, nuts, and other food items.</field_wiki_entry>
  <listFieldName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ecological_roles</listFieldName>
